# 复制为 .env 后按环境填写。.env 已被 .gitignore 忽略，切勿提交真实口令。
# --- 服务 ---
PORT=3100
NODE_ENV=development
# M1（入站防护方案 §4.1）：监听地址。**默认 127.0.0.1，只绑回环**。
# 为什么默认回环：POST /api/v1/external/yijiejieban/appeal 在应用层不校验任何凭证，
# 端口可达即人人可写真实诉求数据；"只在内网"必须由监听地址保证，不能只写在文档里。
#   * 本机反代转发（推荐生产形态）：保持默认 127.0.0.1，由 nginx 连本机回环。
#   * 容器部署且宿主用 127.0.0.1:3100->3100 发布端口：**必须**显式设 0.0.0.0，
#     否则容器内回环与宿主发布端口不通（暴露范围仍由宿主的端口映射收口）。
#   * 设为非回环地址时启动日志会打警告，且必须同时落实 M2 安全组 / M3 网关白名单。
GQXQ_HOST=127.0.0.1

# --- 数据库（复用既有的 gqxq_service；其结构由本仓库 migrations/ 接管）---
GQXQ_DB_HOST=127.0.0.1
GQXQ_DB_PORT=3306
GQXQ_DB_USER=root
GQXQ_DB_PASSWORD=
GQXQ_DB_NAME=gqxq_service
GQXQ_DB_CONNECTION_LIMIT=10
# 测试库（自动化测试专用，禁止指向 gqxq_service）
GQXQ_TEST_DB_NAME=gqxq_service_test

# --- 迁移专用账号（可选；填了就优先用，需 DDL 权限）---
GQXQ_MIGRATE_DB_USER=
GQXQ_MIGRATE_DB_PASSWORD=

# --- 鉴权（必填；缺失则启动失败）---
GQXQ_JWT_SECRET=
GQXQ_JWT_TTL_SECONDS=28800

# --- 初始化管理员（仅首次 seed 使用；留空则拒绝创建，绝不写死默认口令）---
GQXQ_BOOTSTRAP_ADMIN_USERNAME=admin
GQXQ_BOOTSTRAP_ADMIN_PASSWORD=

# --- G3 出站：gqxq -> public-utility 创建填报任务 ---
# 未配置或 MOCK=默认值时，推送走本地桩（PUSH 时用 GQXQ_MOCK 开关），联调时再填真实值
GQXQ_PU_BASE_URL=http://localhost:8080
GQXQ_PU_APP_CODE=gqxq
GQXQ_PU_KEY_ID=
GQXQ_PU_SECRET=
GQXQ_PU_TIMEOUT_MS=15000
# 本地联调用单独起一个桩服务器（server/scripts/mock-public-utility.mjs），
# 把 GQXQ_PU_BASE_URL 指向它即可。**不要在业务代码里做 Mock 分支**。

# --- G4 入站：public-utility -> gqxq 回调验签 ---
# 注意：回调签名算法与入站不同（epochSeconds + "\n" + sha256(body)），实现时不要复用
GQXQ_CALLBACK_KEY_ID=
GQXQ_CALLBACK_KEY_VERSION=v1
GQXQ_CALLBACK_SECRET=
# ACK 语义：NONE 或 BODY。BODY 时响应体必须逐字节等于 GQXQ_CALLBACK_ACK_VALUE
GQXQ_CALLBACK_ACK_MODE=NONE
GQXQ_CALLBACK_ACK_VALUE=SUCCESS

# --- G6 来源对接：宜接就办只读状态适配器 ---
# 有效形态两种：disabled（默认，同步即 501）、file（读下面的快照 JSON）。
# 配成其它值不会生效，只会让 /source-status 报出配置无效，绝不会返回模拟的来源状态。
GQXQ_YJJB_ADAPTER=disabled
GQXQ_YJJB_BASE_URL=
GQXQ_YJJB_TOKEN=
GQXQ_YJJB_TIMEOUT_MS=10000
# adapter=file 时读取的状态快照 JSON（结构 {"<案件公文号>": "<督办状态中文>"}）。
# 快照含真实案卷号，**必须放在仓库外、不要提交**；
# 生成：python scripts/dump-source-status-snapshot.py --out <仓库外路径.json>
# 留空表示 file 形态配置不完整，适配器会回退 disabled 并在 /source-status 报出原因。
GQXQ_YJJB_FILE=
