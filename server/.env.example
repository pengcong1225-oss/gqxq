# 复制为 .env 后按环境填写。.env 已被 .gitignore 忽略，切勿提交真实口令。
# --- 服务 ---
PORT=3100
NODE_ENV=development

# --- 数据库（复用既有的 gqxq_service；其结构由本仓库 migrations/ 接管）---
GQXQ_DB_HOST=127.0.0.1
GQXQ_DB_PORT=3306
GQXQ_DB_USER=root
GQXQ_DB_PASSWORD=
GQXQ_DB_NAME=gqxq_service
GQXQ_DB_CONNECTION_LIMIT=10
# 测试库（自动化测试专用，禁止指向 gqxq_service）
GQXQ_TEST_DB_NAME=gqxq_service_test

# --- 迁移专用账号（可选；填了就优先用，需 DDL 权限）---
GQXQ_MIGRATE_DB_USER=
GQXQ_MIGRATE_DB_PASSWORD=

# --- 鉴权（必填；缺失则启动失败）---
GQXQ_JWT_SECRET=
GQXQ_JWT_TTL_SECONDS=28800

# --- 初始化管理员（仅首次 seed 使用；留空则拒绝创建，绝不写死默认口令）---
GQXQ_BOOTSTRAP_ADMIN_USERNAME=admin
GQXQ_BOOTSTRAP_ADMIN_PASSWORD=
